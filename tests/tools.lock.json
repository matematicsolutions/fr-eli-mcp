    "fr_search": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Keyword-search French legislation or case law on Legifrance.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "fond": {
              "default": "LODA",
              "description": "one of ``LODA`` (laws & decrees), ``CODE`` (codes), ``JURI`` (Cour de cassation\ncase law), ``CONSTIT`` (Conseil constitutionnel - QPC/DC decisions), ``CETAT``\n(administrative case law: Conseil d'Etat, cours administratives d'appel, tribunaux\nadministratifs), ``CNIL`` (CNIL deliberations, incl. sanctions), ``KALI``\n(collective labour agreements / conventions collectives), ``ACCO`` (company-level\nagreements - metadata + search only).",
              "type": "string"
            },
            "page_size": {
              "default": 10,
              "description": "number of hits (1..100).",
              "type": "integer"
            },
            "query": {
              "description": "free-text query (e.g. \"republique numerique\", \"responsabilite\").",
              "type": "string"
            }
