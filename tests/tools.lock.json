        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "decision_id": {
              "description": "a ``JURITEXT...``, ``CONSTEXT...`` or ``CETATEXT...`` identifier (from\n``fr_search`` on fond ``JURI``, ``CONSTIT`` or ``CETAT`` respectively).",
              "type": "string"
            }
          },
